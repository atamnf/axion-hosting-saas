# Database
DB_HOST=localhost
DB_NAME=axion_hosting
DB_USER=axion_user
DB_PASS=change_me

# App
APP_SECRET_KEY=change_this_to_a_long_random_secret
SITE_URL=https://example.com
SITE_NAME=Axion Hosting
AXION_SESSION_LIFETIME=2592000
DEPOST=true

# Pterodactyl
PANEL_URL=https://panel.example.com
PTERO_API_KEY=ptla_your_application_api_key

# Discord OAuth
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=https://example.com/discord-callback.php

# Discord webhooks (optional)
DISCORD_WEBHOOK_URL=
DISCORD_CONTACT_WEBHOOK_URL=
DISCORD_ADMIN_WEBHOOK_URL=
DISCORD_TICKETS_WEBHOOK_URL=

# Telegram OAuth
TELEGRAM_BOT_TOKEN=123456789:replace_with_your_bot_token
TELEGRAM_BOT_USERNAME=your_bot_username

# ENOT payments
ENOT_API_KEY=your_enot_api_key
ENOT_SHOP_ID=your_shop_id
ENOT_SECRET_KEY=your_enot_secret_key
ENOT_WEBHOOK_SECRET=your_webhook_secret

# Optional bot notifications
BOT_API_URL=
BOT_API_PASSWORD=

# Internal API
API_PASS=change_me
